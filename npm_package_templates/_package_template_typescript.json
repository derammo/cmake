{
  "extends": [
    "_package_template_base.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "build:watch": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.json --watch",
    "check:watch": "tsc --noEmit && tsc --watch --noEmit",
    "format": "prettier --print-width 120 --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint",
    "start": "node dist/index"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/json-schema": "^7.0.15",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "@types/node": "^24.0.0",
    "brace-expansion": ">5.0.8"
  }
}