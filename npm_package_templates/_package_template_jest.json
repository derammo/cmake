{
  "scripts": {
    "jest": "jest",
    "jest:watch": "jest --watch",
    "test": "npm run jest",
    "test:watch": "npm run jest:watch"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "jest-junit": "^17.0.0",
    "jest-mock-extended": "^4.0.0",
    "ts-jest": "^29.4.6",
    "@types/jest": "^30.0.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "reporters": [
      "default",
      "jest-junit"
    ],
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "isolatedModules": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
