{
  "type": "commonjs",
  "private": true,
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "scripts": {
    "clean": "rm -rf ./dist tsconfig.tsbuildinfo tsconfig.*.tsbuildinfo *.vsix",
    "build:base": "tsc-absolute -p tsconfig.build.json --sourceRoot \"$npm_package_name/\"",
    "build": "echo \"       building $npm_package_name ...\" && npm run build:base",
    "build:watch": "npm run build:base && tsc-absolute -p tsconfig.build.json --sourceRoot \"$npm_package_name/\" --watch",
    "check": "tsc-absolute --noEmit",
    "lint": "eslint src/",
    "format": "prettier --print-width 120 --no-error-on-unmatched-pattern --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "package:vsix": "vsce package --ignoreFile \"${DERAMMO_VSIX_IGNORE_FILE:?is not set, package the VSIX through the cmake build}\" --out \"${DERAMMO_VSIX_FILE:?is not set, package the VSIX through the cmake build}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "tsc-absolute": "^1.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  }
}
